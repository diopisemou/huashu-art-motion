# Copy to .env (chmod 600) or export in your shell. Never commit the real file.
ANTHROPIC_API_KEY=
# Optional: ElevenLabs for better voices (falls back to edge-tts when unset)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# YouTube OAuth: paths to the files produced by `shorts auth`
YT_CLIENT_SECRET=secrets/client_secret.json
YT_TOKEN=secrets/token.json
# Where huashu-art-motion is checked out (default: ../huashu-art-motion, then vendor/huashu-art-motion)
HUASHU_DIR=
