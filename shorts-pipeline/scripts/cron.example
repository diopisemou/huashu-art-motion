# Run the daily short at 09:07 local time on a machine/VPS that has this repo checked out.
# crontab -e  and paste (adjust paths). Logs go to out/cron.log.
7 9 * * *  cd /path/to/shorts-pipeline && /usr/bin/env PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin uv run shorts run --publish >> out/cron.log 2>&1
